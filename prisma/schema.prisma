generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  title       String
  quote       String   @db.Text
  videoUrl    String?
  imageUrl    String?
  type        String   @default("TEXT")
  category    String
  tier        String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String   // No question mark, it is now mandatory!
  source    String   @default("UNKNOWN")
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}